# This map contains vars that are used in packer templates
# Generated by scripts/generate-vars.sh
# Copy to /packer/packer.pkrvars and populate with real data

env = {
  proxmox_url="http://192.168.x.x:8006/api2/json"
  proxmox_user="user"
  proxmox_password="password"
  proxmox_node="node"
  ssh_username="user"
  ssh_password="password"

  os              = "os"
  cpu_type        = "cpu"
  sockets         = 1
  cores           = 2
  memory          = 2048
  machine         = "pc"
  scsi_controller = "virtio-scsi-single"
  qemu_agent      = true
  
  cloud_init              = true
  cloud_init_storage_pool = "cloud_init_storage"

  vga = {
    type = "std"
  }

  network_adapters = {
    model    = "virtio"    
    bridge   = "vmbr2"
  }

  disks = {
    disk_size    = "6G"
    storage_pool = "storage_pool"
    type         = "scsi"
  }

  boot = {
    type     = "scsi"
    iso      = "local:iso/debian-13.3.0-amd64-netinst.iso"
    unmount  = true
  }

}
